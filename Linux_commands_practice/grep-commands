[root@Astra ~]# mkdir -p ~/grep-practice
cd ~/grep-practice

cat > file <<'EOF'
education
Education is important
physical education
higher education
education system
My qualification is education
PHYSICAL training
science and mathematics
EOF


[root@Astra grep-practice]# grep 'education' file
education
physical education
higher education
education system
My qualification is education


[root@Astra grep-practice]# grep '^education' file
education
education system


[root@Astra grep-practice]# grep 'education$' file
education
physical education
higher education
My qualification is education


[root@Astra grep-practice]# grep -i 'education' file
education
Education is important
physical education
higher education
education system
My qualification is education


[root@Astra grep-practice]# grep -v 'education' file
Education is important
PHYSICAL training
science and mathematics


[root@Astra grep-practice]# grep -e 'education' -e 'physical' file
education
physical education
higher education
education system
My qualification is education


NOTES:-

grep 'education' file

grep '^education' file
# Begin with the string education

grep 'education$' file
# Ending with the string education

grep '^education$' file
# Display only the exact word/line education

grep -i 'education' file
# Search without case sensitivity

grep -v 'education' file
# Display lines except those containing education

grep -e 'education' -e 'physical' file
# Search multiple strings
